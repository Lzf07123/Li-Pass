# 仅本地直接运行后端时使用（docker compose 会忽略此文件，改用根目录 .env.example）
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/portal
REDIS_URL=redis://localhost:6379/0
SESSION_IDLE_DAYS=7
SESSION_DEFAULT_TTL_DAYS=1
JWT_PRIVATE_KEY_PATH=jwt_private.pem
ENCRYPTION_KEY_PATH=encryption.key
# 密钥轮换（可选）：目录内每个 *.pem 文件名即 kid；JWT_ACTIVE_KID 指定签名 kid
# JWT_KEYS_DIR=jwt_keys
# JWT_ACTIVE_KID=portal-rs256-2
EMAIL_BACKEND=console
SMTP_FROM_NAME=Li&Pass
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=2
SMTP_RETRY_DELAY_SECONDS=1
# 2FA 邮箱验证码重发最小间隔（秒）
OTP_RESEND_COOLDOWN_SECONDS=60
# 联邦登出：登出令牌有效期（秒，30–600）与回程分发超时/重试次数
LOGOUT_TOKEN_TTL_SECONDS=120
BACKCHANNEL_LOGOUT_TIMEOUT_SECONDS=5
BACKCHANNEL_LOGOUT_MAX_RETRIES=2
# 公开注册入口：false 时普通注册关闭，只保留邀请注册
PUBLIC_REGISTRATION_ENABLED=true
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_CLEANUP_INTERVAL_SECONDS=21600
# 过期 OTP/授权码保留期（小时），超期后由后台维护任务删除
EPHEMERAL_RETENTION_HOURS=168
# 审计日志保留天数
AUDIT_RETENTION_DAYS=180
# 已吊销/已过期会话保留天数
SESSION_RETENTION_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 管理端邀请限流（按来源 IP），批量邀请按人数累计
ADMIN_INVITE_RATE_LIMIT=100
ADMIN_INVITE_RATE_WINDOW_SECONDS=3600
