server {
    listen 5173;
    server_name _;
    server_tokens off;

    # 静态文件缓存元数据，减少重复 stat 的磁盘 IO
    open_file_cache max=1000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    root /usr/share/nginx/html;
    index index.html;

    # 静态资源压缩（构建产物均为带 hash 的缓存文件）
    # gzip_static 直接发送构建时预生成的 .gz，避免每个请求重复压缩。
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        font/woff2;

    # 安全头必须逐 location 重复：nginx 的 add_header 在当前块有声明时不会继承父级
    # 注意：HTTPS 由部署环境的外层网关终结；HSTS 由外层网关统一配置
    # （后端在生产同值兜底签发，见 docs/deployment.md）。
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-XSS-Protection "0" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # style-src 禁用 unsafe-inline：只放行 style 属性（style-src-attr），
    # 阻断 <style> 元素注入；动态进度条/动画等依赖 style 属性的组件不受影响。
    # img-src 放行 https:（授权应用 logo 为管理员登记的第三方地址）；配合
    # Referrer-Policy no-referrer 不泄露门户路径；script 全部外链（首帧主题脚本）。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${CONNECT_SRC}; img-src 'self' data: https: ${CONNECT_SRC}; style-src 'self'; style-src-attr 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # SPA 入口不做长缓存，保证每次发布后拿到最新 index.html
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-XSS-Protection "0" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${CONNECT_SRC}; img-src 'self' data: https: ${CONNECT_SRC}; style-src 'self'; style-src-attr 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # 带内容 hash 的构建产物可长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-XSS-Protection "0" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${CONNECT_SRC}; img-src 'self' data: https: ${CONNECT_SRC}; style-src 'self'; style-src-attr 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # 固定品牌图标（WebP 单格式）可短缓存
    location = /favicon.webp {
        expires 7d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-XSS-Protection "0" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${CONNECT_SRC}; img-src 'self' data: https: ${CONNECT_SRC}; style-src 'self'; style-src-attr 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # BIMI 发件人头像 Logo（SVG Tiny PS），短缓存
    location = /bimi/logo.svg {
        expires 7d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-XSS-Protection "0" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${CONNECT_SRC}; img-src 'self' data: https: ${CONNECT_SRC}; style-src 'self'; style-src-attr 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
