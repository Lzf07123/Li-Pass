# Li&Pass 前端环境变量示例。
# 使用：cp .env.example .env，再按需取消注释。
#
# 后端 API 基地址（api 客户端的 BASE_URL，并注入生产 CSP 的 connect-src/img-src）。
# - 单域名网关部署（推荐，docker compose）：留空，前端经 /api、/oauth2 同源转发；
# - 宿主机直连后端开发（npm run dev，不经网关）：指向后端地址。
#
# VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://localhost:8000

# 品牌与站点信息（构建期注入 frontend/src/lib/brand.ts；未设置时用该文件内置默认值）：
# VITE_APP_NAME=Li&Pass
# VITE_APP_TAGLINE=一次注册，通行所有授权网站

# 页脚备案信息（文案留空则不显示对应链接，避免占位假备案号）：
# VITE_ICP_FILING_TEXT=京ICP备XXXXXXXX号
# VITE_ICP_FILING_URL=https://beian.miit.gov.cn/
# VITE_ICP_FILING_ICON=/badges/icp.webp
# VITE_POLICE_FILING_TEXT=京公网安备XXXXXXXX号
# VITE_POLICE_FILING_URL=https://beian.mps.gov.cn/
# VITE_POLICE_FILING_ICON=/badges/police.webp

# 页脚附加链接（JSON 数组；留空不展示）：
# VITE_FOOTER_LINKS=[{"label":"隐私政策","href":"/privacy"},{"label":"服务条款","href":"/terms"}]
