# 环境：本地生产形态演示用 development；真实生产必须 production
ENVIRONMENT=development

# 域名与来源
FRONTEND_BASE_URL=http://localhost:5173
JWT_ISSUER=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# 示例网站（可选）
DEMO_CLIENT_ID=demo-site
DEMO_REDIRECT_URI=http://localhost:3001/callback
DEMO_SECRET_KEY=

# 会话 Cookie：生产 HTTPS 下必须 true / none
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# 数据与缓存
DATABASE_URL=postgresql+psycopg://portal:portal@postgres:5432/portal
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal

# 存储后端
PENDING_REQUEST_STORE=redis
TWOFA_STORE=redis
RATE_LIMITER=redis

# 密钥路径（容器内 /app/keys 命名卷持久化）
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
ENCRYPTION_KEY_PATH=/app/keys/encryption.key

# 邮件（生产设置为 smtp 并使用真实发件地址）
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Portal OSS
SMTP_USE_TLS=true
