# 编排文件同样使用「示例 + 复制」约定：
#   cp docker-compose.example.yaml docker-compose.yaml
# （本机 docker-compose.yaml 已 gitignore，可按环境就地修改。）

# 环境：development（本地/演示）或 production（真实部署，启动时强校验）
ENVIRONMENT=development

# 单域名网关对外地址：/ → 前端，/api、/oauth2 → 后端，/demo → 演示站
# 本地验证用 http://localhost；真实部署改为你的域名，如 https://sso.example.com
PUBLIC_BASE_URL=http://localhost

# PostgreSQL / Redis（compose 自动拼连接串，只需配置以下拆分项）
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal
REDIS_PASSWORD=portal-dev-redis
REDIS_APPENDONLY=yes

# 数据与缓存切换：
# 默认（--profile bundle）使用编排内 postgres/redis，只需配置上面的拆分项；
# 使用远程 PostgreSQL/Redis 时取消注释以下两项，并去掉 --profile bundle 启动：
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/portal
# REDIS_URL=redis://:password@redis.example.com:6379/0

# 会话与安全
SESSION_COOKIE_NAME=lipass_session
SESSION_TTL_DAYS=30
# 未勾选“记住我”时的会话有效期（天）；Cookie 为会话级，关闭浏览器即失效
SESSION_DEFAULT_TTL_DAYS=1
# 会话空闲超时：超过该分钟数无任何活动即强制下线（默认 720，即 12 小时，≥5）
SESSION_IDLE_MINUTES=720
# 登录可信设备有效期：勾选「信任此设备」后该设备登录免二次验证的天数（仅登录环节，默认 7）
TRUSTED_DEVICE_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost"]
# 127.0.0.1 供容器健康检查；backend 供演示站等容器内服务调用
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
# 默认信任编排内网关的固定 IP（172.30.0.10）；
# 自定义网络或外部反向代理时，改为实际网关 IP/CIDR
FORWARDED_ALLOW_IPS=172.30.0.10

# 站点与邮件
# FRONTEND_BASE_URL / JWT_ISSUER 通常由 PUBLIC_BASE_URL 派生，仅特殊场景单独覆盖
# 仅通过 gateway（nginx）访问，前端/后端不向宿主机开放端口：
# FRONTEND_BASE_URL=http://localhost
# JWT_ISSUER=http://localhost
EMAIL_BACKEND=console

# 公开注册入口：false 时普通注册关闭，只保留邀请注册；用户会看到关闭提示
PUBLIC_REGISTRATION_ENABLED=true

# 真实发件（EMAIL_BACKEND=smtp 时启用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Li&Pass
SMTP_USE_TLS=true
SMTP_TLS_VERIFY=true
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=2
SMTP_RETRY_DELAY_SECONDS=1

# 2FA 邮箱验证码重发最小间隔（秒）；首次发送需用户在二次验证页点击“获取验证码”
OTP_RESEND_COOLDOWN_SECONDS=60

# 存储与限流：development 可用 memory；production 必须 redis
PENDING_REQUEST_STORE=memory
TWOFA_STORE=memory
RATE_LIMITER=memory

# 联邦登出：登出令牌有效期（秒，30–600）与回程分发超时/重试次数
LOGOUT_TOKEN_TTL_SECONDS=120
BACKCHANNEL_LOGOUT_TIMEOUT_SECONDS=5
BACKCHANNEL_LOGOUT_MAX_RETRIES=2

# 登录限流：按邮箱+IP 失败次数、按 IP 尝试次数、全局限邮箱尝试次数三层叠加，防爆破
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_IP_RATE_LIMIT=20
LOGIN_IP_RATE_WINDOW_SECONDS=900
LOGIN_EMAIL_RATE_LIMIT=10
LOGIN_EMAIL_RATE_WINDOW_SECONDS=900

# OIDC 端点限流（按来源 IP，防滥用/DoS）
AUTHORIZE_RATE_LIMIT=120
AUTHORIZE_RATE_WINDOW_SECONDS=60
TOKEN_RATE_LIMIT=120
TOKEN_RATE_WINDOW_SECONDS=60

# 敏感操作 step-up 复核：窗口时长（分钟，0 关闭窗口）与失败限流（按邮箱+IP / 全局限邮箱）
STEPUP_WINDOW_MINUTES=30
STEPUP_RATE_LIMIT=5
STEPUP_RATE_WINDOW_SECONDS=900
STEPUP_EMAIL_RATE_LIMIT=10
STEPUP_EMAIL_RATE_WINDOW_SECONDS=900

# OAuth 客户端黑名单接口限流（按 client_id）
CLIENT_BLOCK_RATE_LIMIT=100
CLIENT_BLOCK_RATE_WINDOW_SECONDS=3600

# 审计日志保留天数，超期由后台维护任务删除
AUDIT_RETENTION_DAYS=180
# 已吊销/已过期会话保留天数，超期由后台维护任务删除
SESSION_RETENTION_DAYS=30

# 管理端邀请
# 单次/周期内管理员可发送的邀请数量（按来源 IP 计），批量邀请按人数累计
ADMIN_INVITE_RATE_LIMIT=100
ADMIN_INVITE_RATE_WINDOW_SECONDS=3600

# 头像
# 未引用头像文件自动清理周期（秒）；0 表示关闭周期清理，仍保留启动时一次清理
AVATAR_CLEANUP_INTERVAL_SECONDS=21600
# 过期 OTP/授权码保留期（小时）；超期后由后台维护任务删除，防止表无限增长
EPHEMERAL_RETENTION_HOURS=168

# 性能调优
# 数据库连接池：单 worker 默认 5+10；提高 worker 数时应同步放大池大小
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Redis 内存上限（仅 bundle 模式生效）；只淘汰带 TTL 的键，避免容器 OOM
REDIS_MAXMEMORY=192mb
# 后端 uvicorn worker 数：生产多核可调高；使用 memory 存储的本地模式必须保持 1
UVICORN_WORKERS=1
# 热更新形态（docker-compose.hot.yaml）的 worker 数：SIGHUP 逐个 worker 优雅回收，
# ≥2 才能零停机；与 UVICORN_WORKERS 解耦
# HOT_UVICORN_WORKERS=2

# 密钥路径（compose 容器内必须为绝对路径，密钥持久化在 backend-keys 卷）
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
ENCRYPTION_KEY_PATH=/app/keys/encryption.key
# 密钥轮换（可选）：目录内每个 *.pem 文件名即 kid；JWT_ACTIVE_KID 指定签名 kid
# JWT_KEYS_DIR=/app/keys/jwt
# JWT_ACTIVE_KID=lipass-rs256-2

# 前端构建时注入的后端地址：http://localhost:8000 = 直连后端开发模式
# 单域名网关模式请留空（同源，经网关访问 /api）
VITE_API_BASE_URL=

# 前端品牌与站点信息（构建期注入，留空使用代码内置默认值；详见 frontend/.env.example）
# VITE_APP_NAME=Li&Pass
# VITE_APP_TAGLINE=一次注册，通行所有授权网站
# VITE_ICP_FILING_TEXT=京ICP备XXXXXXXX号
# VITE_ICP_FILING_URL=https://beian.miit.gov.cn/
# VITE_ICP_FILING_ICON=/badges/icp.webp
# VITE_POLICE_FILING_TEXT=京公网安备XXXXXXXX号
# VITE_POLICE_FILING_URL=https://beian.mps.gov.cn/
# VITE_POLICE_FILING_ICON=/badges/police.webp
# VITE_FOOTER_LINKS=[{"label":"隐私政策","href":"/privacy"}]

# 示例授权网站（OIDC 演示）
DEMO_CLIENT_ID=demo-site
DEMO_REDIRECT_URI=http://localhost/demo/callback
DEMO_HOME_URL=http://localhost/demo/
DEMO_LOGOUT_URI=http://localhost/demo/logout
DEMO_SECRET_KEY=

# ── 镜像地址统一前缀（默认留空 = 官方 Docker Hub） ──
# 私有仓库/内网镜像源时填镜像源地址，必须以 / 结尾，例如 registry.example.com/
# 会统一作用于：postgres、redis、自建服务镜像（backend/frontend/demo-site）及构建基础镜像
IMAGE_REGISTRY=

# pip 镜像源（backend/demo-site 构建期与本地开发使用；默认中科大镜像）
# 海外构建环境可改回官方源：PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple

# APT 镜像源（backend/demo-site 构建期 apt-get update 使用；默认中科大镜像）
# 海外构建环境可改回官方源：APT_MIRROR=http://deb.debian.org/debian
APT_MIRROR=http://mirrors.ustc.edu.cn/debian

# 容器时区（默认 Asia/Shanghai，可通过 TZ 覆盖）
TZ=Asia/Shanghai

# ── ip2region 离线 IP 归属地库（会话/审计归属地展示、登录地域统计与库更新） ──
# 数据目录（生产必须为绝对路径，构建期已内置 v3.17.0；重建镜像后自动恢复）
# IP2REGION_DATA_DIR=/app/data/ip2region
# 定期自动更新：默认关闭；开启后按间隔检查 GitHub 最新版本（可在站点设置中运行时切换）
# IP2REGION_AUTO_UPDATE_ENABLED=false
# IP2REGION_UPDATE_INTERVAL_HOURS=24
# 注：Gitee 的 raw 端点对 xdb 数据文件返回 403（实测），不能作为运行期更新源；
# 请保持默认 GitHub 地址。构建期不再联网下载：数据与绑定源码已随仓库入库。

# ── 生产部署示例（把以上值按需替换，并删除下面注释） ──
# ENVIRONMENT=production
# FRONTEND_BASE_URL=https://portal.example.com
# JWT_ISSUER=https://auth.example.com
# CORS_ORIGINS=["https://portal.example.com"]
# ALLOWED_HOSTS=["portal.example.com","127.0.0.1"]（生产必填真实域名；127.0.0.1 供容器健康检查）
# SESSION_COOKIE_SECURE=true
# SESSION_IDLE_MINUTES=720（会话空闲超时分钟数）
# 同站部署（前后端同域名/同可注册域）：SESSION_COOKIE_SAMESITE=lax（推荐，CSRF 风险最小）
# 跨站部署（portal.example.com 与 auth.example.com 完全不同域）：必须 none + secure=true，
# 否则浏览器跨站 XHR 不会携带 Lax Cookie，门户将表现为无法登录；none 的 CSRF 风险由后端 Origin 校验兜底
# SESSION_COOKIE_SAMESITE=lax
# POSTGRES_PASSWORD=你的密码
# REDIS_PASSWORD=你的Redis密码
# REDIS_APPENDONLY=yes（Redis AOF 持久化，生产建议开启）
# PENDING_REQUEST_STORE=redis
# TWOFA_STORE=redis
# RATE_LIMITER=redis
# 编排内网关保持默认 172.30.0.10；外部反代时填网关IP/CIDR（多个用逗号分隔）
# FORWARDED_ALLOW_IPS=172.30.0.10
# JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem（生产必须为绝对路径）
# ENCRYPTION_KEY_PATH=/app/keys/encryption.key（生产必须为绝对路径）
# IMAGE_REGISTRY=registry.example.com/（统一镜像前缀，含末尾斜杠；离线/私有仓库场景使用）
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=你的密码
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Li&Pass
