# 上游连接池：复用 keepalive 连接，避免每个请求都新建 TCP 连接
upstream backend_http {
    server backend:8000;
    keepalive 32;
}
upstream frontend_http {
    server frontend:5173;
    keepalive 32;
}

# API JSON 与 HTML 响应压缩（前端构建产物已由前端容器自行压缩）
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types
    text/plain
    text/css
    application/javascript
    application/json
    application/xml
    image/svg+xml;

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Docker 内嵌 DNS：演示站仅在 demo profile 下运行，
    # 用请求期动态解析避免 nginx 启动时因 demo-site 未启动而整体退出。
    resolver 127.0.0.11 valid=10s;

    # 上传头像 ≤5MB，留余量
    client_max_body_size 6m;

    # 所有 location 通用：透传真实 Host，供后端 TrustedHost / 限流使用
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # 后端 API
    location /api/ {
        proxy_pass http://backend_http;
    }

    # 健康检查
    location = /healthz {
        proxy_pass http://backend_http;
    }
    location = /readyz {
        proxy_pass http://backend_http;
    }

    # OIDC 端点与发现文档
    location /oauth2/ {
        proxy_pass http://backend_http;
    }
    location /.well-known/ {
        proxy_pass http://backend_http;
    }

    # API 文档
    location /docs {
        proxy_pass http://backend_http;
    }
    location /redoc {
        proxy_pass http://backend_http;
    }
    location = /openapi.json {
        proxy_pass http://backend_http;
    }

    # 后端托管的头像等静态资源：文件名带 UUID，可安全长缓存。
    # 缓存头由后端按状态码签发（200 长缓存 / 错误 no-store），
    # 网关不再覆盖，避免把 404/500 响应也缓存 7 天。
    location /uploads/ {
        proxy_pass http://backend_http;
    }

    # OIDC 演示站（剥离 /demo 前缀；上游按 DEMO_PATH_PREFIX 生成正确链接）
    location = /demo {
        return 301 /demo/;
    }
    location /demo/ {
        set $demo_upstream demo-site:3001;
        # proxy_pass 带变量时其 URI 部分会整体替换原始请求路径（而非只替换
        # location 前缀），必须先用 rewrite 显式剥离 /demo 前缀，再不带 URI
        # 转发，否则 /demo/login 会被透传成 /，演示站所有子路径 404/405。
        rewrite ^/demo/(.*)$ /$1 break;
        proxy_pass http://$demo_upstream;
    }

    # 其余全部交给前端 SPA
    location / {
        proxy_pass http://frontend_http;
    }
}
