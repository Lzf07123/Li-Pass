server {
    listen 80;
    server_name _;
    server_tokens off;

    # 上传头像 ≤5MB，留余量
    client_max_body_size 6m;

    # 所有 location 通用：透传真实 Host，供后端 TrustedHost / 限流使用
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # 后端 API
    location /api/ {
        proxy_pass http://backend:8000;
    }

    # 健康检查
    location = /healthz {
        proxy_pass http://backend:8000;
    }
    location = /readyz {
        proxy_pass http://backend:8000;
    }

    # OIDC 端点与发现文档
    location /oauth2/ {
        proxy_pass http://backend:8000;
    }
    location /.well-known/ {
        proxy_pass http://backend:8000;
    }

    # API 文档
    location /docs {
        proxy_pass http://backend:8000;
    }
    location /redoc {
        proxy_pass http://backend:8000;
    }
    location = /openapi.json {
        proxy_pass http://backend:8000;
    }

    # 后端托管的头像等静态资源
    location /uploads/ {
        proxy_pass http://backend:8000;
    }

    # OIDC 演示站（剥离 /demo 前缀；上游按 DEMO_PATH_PREFIX 生成正确链接）
    location = /demo {
        return 301 /demo/;
    }
    location /demo/ {
        proxy_pass http://demo-site:3001/;
    }

    # 其余全部交给前端 SPA
    location / {
        proxy_pass http://frontend:5173;
    }
}
